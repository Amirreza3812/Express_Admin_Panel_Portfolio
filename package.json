{
  "name": "cafe-management-api",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "lint": "eslint .",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:seed": "npx sequelize-cli db:seed:all",
    "setup": "node scripts/setup.js",
    "db:reset": "node -e \"require('./src/utils/dbHelpers').resetDatabase()\"",
    "db:stats": "node -e \"require('./src/utils/dbHelpers').getDatabaseStats().then(console.log)\"",
    "create:admin": "node -e \"const {createSuperAdmin} = require('./src/utils/dbHelpers'); createSuperAdmin({name: process.argv[1], email: process.argv[2], password: process.argv[3]}).then(() => process.exit())\" --",
    "test:endpoints": "node test-endpoints.js",
    "test:frontend": "node test-frontend-ready.js"
  },
  "keywords": [
    "cafe",
    "management",
    "api",
    "nodejs",
    "express",
    "restaurant"
  ],
  "author": "Getsu Team",
  "license": "MIT",
  "type": "commonjs",
  "description": "Professional Cafe Management System API with customer and admin functionality",
  "dependencies": {
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "mysql2": "^3.14.1",
    "pg": "^8.16.2",
    "sequelize": "^6.37.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
